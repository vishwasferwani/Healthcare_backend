            "body": {
              "mode": "raw",
              "raw": "{\n  \"disease\": \"Recovered\"\n}"
            },
            "url": "{{base_url}}/api/patients/1/"
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/patients/1/"
          }
