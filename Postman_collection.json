            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"age\": 30,\n  \"gender\": \"Female\",\n  \"disease\": \"Fever\",\n  \"phone\": \"9999999999\",\n  \"address\": \"Hyderabad\"\n}"
            },
            "url": "{{base_url}}/api/patients/"
